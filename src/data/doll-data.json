{
 "TRAD_PIECES": [
  {
   "id": "quan-lua",
   "name": "Quần lụa trắng",
   "note_vi": "Quần lụa trắng ống rộng truyền thống, mặc cùng áo dài, áo ngũ thân, áo tấc."
  },
  {
   "id": "quan-den",
   "name": "Quần đen",
   "note_vi": "Quần đen ống rộng truyền thống Nam Bộ, mặc cùng áo bà ba."
  },
  {
   "id": "vay-den",
   "name": "Váy đụp đen",
   "note_vi": "Váy đụp đen dài chấm gót, lớp nền bên trong của áo tứ thân Bắc Bộ."
  },
  {
   "id": "xiem",
   "name": "Xiêm",
   "note_vi": "Xiêm quây lụa phủ ngoài quần hoặc mặc trong áo Nhật Bình, giao lĩnh."
  },
  {
   "id": "yem",
   "name": "Yếm đào",
   "note_vi": "Áo yếm lót che ngực cổ truyền, mặc bên trong áo tứ thân."
  },
  {
   "id": "that-lung",
   "name": "Thắt lưng lụa",
   "note_vi": "Dải lụa mềm buộc ngang eo giữ vạt áo, buông hai múi trước bụng."
  },
  {
   "id": "ao-lot-trang",
   "name": "Áo lót trắng",
   "note_vi": "Áo lót trắng cổ đứng mặc bên trong áo ngũ thân, áo the."
  },
  {
   "id": "ao-lot-giao",
   "name": "Áo lót giao lĩnh",
   "note_vi": "Áo lót cổ chéo màu trắng mặc bên trong áo giao lĩnh."
  },
  {
   "id": "ao-dai-lot",
   "name": "Áo dài lót",
   "note_vi": "Áo dài lót cổ đứng mặc bên trong áo Nhật Bình."
  },
  {
   "id": "khan-vanh",
   "name": "Khăn vành",
   "note_vi": "Khăn vành dây quấn nhiều vòng quanh đầu của hoàng tộc, mệnh phụ triều Nguyễn."
  }
 ],
